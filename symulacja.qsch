  «text (1120,2660) 1 7 0 0x1000000 -1 -1 "ï»¿.plot V(TVS_U)*I(TVS_I) V(VAR_U)*I(VAR_I) V(GDT_U)*I(GDT_I)"»
  «text (1170,1840) 1 7 0 0x1000000 -1 -1 "ï»¿.meas E_VAR_KJ integ V(VAR_U)*I(VAR_I)/1000 from 0 to Period"»
  «text (1170,1640) 1 7 0 0x1000000 -1 -1 "ï»¿.meas E_GDT_KJ integ V(GDT_U)*I(GDT_I)/1000 from 0 to Period"»
